# D2 architecture 512-embd, l=6 — round-2 stable resume.
# Resumes from d2_arch_512_l6_snapshot_best.pt (iter 26072, beam7=21.4% on 14 samples)
# with a smaller LR and denser validation so the monitor's 20-min snapshots
# land on actual peaks rather than plateaus between validations. Same data /
# architecture as d2_arch_512_l6.env.
export DATA_TAG=d2
export MODEL_TAG=d2_arch_512r2_l6
export EXP_NAME=experiment_d2_arch_512r2_l6_stable
export BLOCK_SIZE=850
export N_LAYER=6
export N_HEAD=8
export N_EMBD=512
export BATCH_SIZE=200
export NUM_EPOCHS=10
export ITERATION_PERIOD=1000
export FINETUNE_LR=0.0001
export EXTENDED_VOCAB=true
