# D2 architecture 512-embd, l=6 — round-3 fresh run.
# From scratch (no READ_CKPT). Standard paper LR (6e-4) + dense validation
# (iteration_period=1000) so the monitor's 20-min snapshots capture peaks.
# Writes checkpoints into data_storage/things_on_paper/model/round3/.
export DATA_TAG=d2
export MODEL_TAG=d2_arch_512r3_l6
export EXP_NAME=experiment_d2_arch_512r3_l6
export BLOCK_SIZE=850
export N_LAYER=6
export N_HEAD=8
export N_EMBD=512
export BATCH_SIZE=200
export NUM_EPOCHS=10
export ITERATION_PERIOD=1000
export FINETUNE_LR=0.0006
export EXTENDED_VOCAB=true
export ROUND_DIR=round3
