# D2 architecture scaling: n_embd=768, n_layer=6 (paper §4.2, Fig 4).
# Requires the D2 dataset — generate via `sbatch gen_dataset.sh configs/d2_dataset.env` first.
export DATA_TAG=d2
export MODEL_TAG=d2_arch_768_l6
export EXP_NAME=experiment_d2_arch_768_l6
export BLOCK_SIZE=850
export N_LAYER=6
export N_HEAD=8
export N_EMBD=768
export BATCH_SIZE=200
export NUM_EPOCHS=5
export ITERATION_PERIOD=8000
export FINETUNE_LR=0.0006
export EXTENDED_VOCAB=true
