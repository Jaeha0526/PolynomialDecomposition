# D2 architecture 768-embd, l=6 — round-2 fresh run.
# From scratch: the original 768's peak 23.3% snapshot was rotated before the
# best-preservation feature existed, and no later pass has matched that peak.
# Uses standard paper LR (6e-4) but with ITERATION_PERIOD=1000 so the monitor's
# 20-min cadence captures peaks tightly.
export DATA_TAG=d2
export MODEL_TAG=d2_arch_768r2_l6
export EXP_NAME=experiment_d2_arch_768r2_l6_fresh
export BLOCK_SIZE=850
export N_LAYER=6
export N_HEAD=8
export N_EMBD=768
export BATCH_SIZE=200
export NUM_EPOCHS=10
export ITERATION_PERIOD=1000
export FINETUNE_LR=0.0006
export EXTENDED_VOCAB=true
