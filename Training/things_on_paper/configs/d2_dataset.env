# Paper D2 dataset spec (§3.1 / Table 1 D2 row + §3.2 second-part note).
# Used for the D2 architecture sweep and the BGRPO baseline.
#
#   2M unique training samples, backward-generated:
#     * 3 inner variables (a0..a2), 3 outer variables (b0..b2)
#     * max_degree = 3 for both
#     * max_terms = 3 for both
#     * coefficients in [-5, 5]
#
# Submit with:
#   sbatch Training/things_on_paper/gen_dataset.sh \
#          Training/things_on_paper/configs/d2_dataset.env
#
# On a 64-core expansion node, ~8 hours wall time.

export DATA_TAG=d2

export NUM_INNER_VARS=3
export NUM_OUTER_VARS=3
export MAX_DEGREE_INNER=3
export MAX_DEGREE_OUTER=3
export MAX_TERMS_INNER=3
export MAX_TERMS_OUTER=3
export COEFF_MIN_INNER=-5
export COEFF_MAX_INNER=5
export COEFF_MIN_OUTER=-5
export COEFF_MAX_OUTER=5

export NUM_TRAIN=2000000
export NUM_TEST=3000
export NUM_VALID=1000
