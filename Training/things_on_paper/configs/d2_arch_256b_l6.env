# D2 architecture 256-embd, l=6 — "stable" branch.
# Resumes from d2_arch_256_l6_snapshot_best.pt (iter 56022, beam7=35.7%)
# with a smaller LR and denser validation so the monitor's 20-min snapshots
# land on actual peaks rather than plateaus between validations.
# Same dataset + shape as d2_arch_256_l6.env (so tokenizer + positional
# embeddings match the resumed checkpoint); only LR / iteration cadence /
# run tags differ.
export DATA_TAG=d2
export MODEL_TAG=d2_arch_256b_l6
export EXP_NAME=experiment_d2_arch_256b_l6_stable
export BLOCK_SIZE=850
export N_LAYER=6
export N_HEAD=8
export N_EMBD=256
export BATCH_SIZE=200
export NUM_EPOCHS=5
export ITERATION_PERIOD=1000
export FINETUNE_LR=0.0001
export EXTENDED_VOCAB=true
